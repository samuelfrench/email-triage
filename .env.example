# Copy this file to .env and fill in your values.
#
# .env is gitignored — never commit secrets.

# Required: your Gmail address (used to detect self-sent emails)
USER_EMAIL=you@example.com

# Optional: Anthropic API key. Without it, classification falls back to
# rule-based only (still works well for most marketing/automated emails).
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional: Whitelist domains (comma-separated). Emails from these domains
# are always treated as high priority.
# WHITELIST_DOMAINS=important-client.com,business-partner.org

# Optional: Override the AI model (defaults to claude-sonnet-4-6).
# AI_MODEL=claude-sonnet-4-6

# Optional: Override the low-priority Gmail label name.
# LOW_PRIORITY_LABEL=LowPriority
